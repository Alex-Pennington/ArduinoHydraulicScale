// arduino_secrets.h.example
//
// Copy to `arduino_secrets.h` and fill in real values. The real file is gitignored
// and MUST NOT be committed — it carries the WiFi PSK and the MQTT password.
//
// PLC #4 (tractor hydraulic scale) targets the estate broker on the farm LAN.
// See BRIEF.md "Decisions" for the settled SSID and broker; the secrets themselves
// are not recorded in any tracked file.

#define SECRET_SSID         "your-ssid"           // WiFi network name
#define SECRET_PASS         "your-wifi-psk"       // WPA passphrase
// SECRET_MQTT_BROKER must be the LAN form of the estate broker.
// The board sits on the farm LAN via FOXTROTBRAVO and reaches it as 192.168.10.99.
// Saga reaches the SAME broker as farm1.internal (10.77.77.13), an overlay address
// that the board has no route to. Do not copy the overlay form into this file.
#define SECRET_MQTT_BROKER  "192.168.10.99"       // estate broker, LAN form
#define SECRET_MQTT_USER    "your-mqtt-user"      // used at :170
#define SECRET_MQTT_PASS    "your-mqtt-password"  // sent in the clear on port 1883
